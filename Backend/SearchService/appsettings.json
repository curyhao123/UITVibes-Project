{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Embedding": {
    "BaseUrl": "http://tei-embed",
    "Model": "BAAI/bge-m3",
    "Dimensions": 1024,
    "MaxBatchSize": 32,
    "Normalize": true,
    "TimeoutSeconds": 30
  },
  "Rerank": {
    "BaseUrl": "http://tei-rerank",
    "Model": "BAAI/bge-reranker-v2-m3",
    "MaxTexts": 50,
    "TimeoutSeconds": 30
  }
}
